  <Kpis>
    <Kpi dwd:design-time-name="92e54694-6944-4198-8232-c9661b219e97">
      <ID>KPI</ID>
      <Name>KPI Average Response Time</Name>
      <AssociatedMeasureGroupID>Fact Incident</AssociatedMeasureGroupID>
      <Value>[Measures].[First Pump Attendance Time]</Value>
      <Goal>360</Goal>
      <Status>CASE
  WHEN KPIValue("KPI Average Response Time") &lt;= 300 THEN 1
  WHEN KPIValue("KPI Average Response Time") &lt;= 360 THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Shapes</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>