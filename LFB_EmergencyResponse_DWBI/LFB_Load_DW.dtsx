                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    ISNULL(BoroughCode,'UNKNOWN') AS IncGeo_BoroughCode,
    ISNULL(BoroughName,'Unknown') AS IncGeo_BoroughName,
    'Greater London' AS LondonRegion
FROM dbo.StgBorough
WHERE BoroughCode IS NOT NULL</property>
