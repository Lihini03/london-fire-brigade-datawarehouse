            <component
              refId="Package\Transform and Load Fact Incident\Extract from StgIncident"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Extract from StgIncident"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    IncidentNumber,
    CONVERT(INT, CONVERT(VARCHAR,
        CONVERT(DATE, DateOfCall, 103), 112))   AS DateKey,
    ISNULL(s.StationName,'Unknown')             AS StationName,
    ISNULL(i.IncGeo_BoroughCode,'UNKNOWN')      AS BoroughCode,
    ISNULL(it.IncidentGroup,'Unknown')          AS IncidentGroup,
    ISNULL(it.StopCodeDescription,'Unknown')    AS StopCodeDescription,
    ISNULL(p.PropertyCategory,'Unknown')        AS PropertyCategory,
    ISNULL(p.PropertyType,'Unknown')            AS PropertyType,
    ISNULL(CAST(i.FirstPumpArriving_AttendanceTime
                AS INT),0)                      AS FirstPumpAttendanceTime,
    ISNULL(CAST(i.NumPumpsAttending
                AS INT),0)                      AS NumPumpsAttending,
    ISNULL(CAST(i.NumStationsWithPumpsAttending
                AS INT),0)                      AS NumStationsAttending,
    ISNULL(CAST(i.PumpHoursRoundUp
                AS DECIMAL(10,2)),0)            AS PumpHoursRoundUp,
    ISNULL(CAST(i.Notional_Cost
                AS DECIMAL(10,2)),0)            AS Notional_Cost
FROM dbo.StgIncident i
LEFT JOIN dbo.StgStation        s   ON i.stationID   = s.stationID
LEFT JOIN dbo.StgIncidentType   it  ON i.TypeCode     = it.TypeCode
LEFT JOIN dbo.StgProperty       p   ON i.PropertyCode = p.PropertyCode</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
